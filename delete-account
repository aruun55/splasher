<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delete Account - Splasher</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800 min-h-screen flex items-center justify-center p-6">
  <div class="w-full max-w-md bg-gray-100 rounded-2xl shadow-lg p-8">
    <h1 class="text-2xl font-bold mb-4 text-center">Request Account Deletion</h1>
    <p class="mb-6 text-sm text-gray-600 text-center">
      Please enter your email and username below. Your account will be permanently deleted within 30 days.
    </p>
    <form action="https://formsubmit.co/teams@splasher.app" method="POST" class="space-y-4">
      <input type="hidden" name="_subject" value="Account Deletion Request">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_autoresponse" value="We’ve received your deletion request. It will be processed within 30 days.">

      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring focus:border-blue-300">
      </div>
      <div>
        <label for="username" class="block text-sm font-medium">Username</label>
        <input type="text" id="username" name="username" required class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring focus:border-blue-300">
      </div>
      <button type="submit" class="w-full bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition">
        Submit Deletion Request
      </button>
    </form>
    <div id="confirmation" class="text-center text-sm text-gray-500 mt-4">
      If you submitted the form, your account will be deleted within 30 days.
    </div>
  </div>
</body>
</html>
